{
  "name": "dsh-d2-diagrams",
  "version": "0.1.0",
  "description": "D2 diagram preview for DeepSeek Harness: open .d2 files in the right Sidebar with a live-rendered chart, a code editor, and switchable chart / code / split views.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KorionCN/dsh-d2-diagrams.git"
  },
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "d2",
    "d2lang",
    "diagram"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar-documentpreview"
      ]
    }
  },
  "scripts": {
    "build": "node build.mjs"
  },
  "devDependencies": {
    "dompurify": "^3.2.4",
    "esbuild": "^0.25.0",
    "jsdom": "^30.1.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
